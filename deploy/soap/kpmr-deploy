#!/usr/bin/env bash
set -Eeuo pipefail

DIR=/opt/logicplanes/kpmr
STATE=/var/lib/logicplanes/kpmr
REPO=git@github.com:logicplanes/kpmr.git
HOST=kpmr.kaeso.app
export GIT_SSH_COMMAND="ssh -i $DIR/deploy-key -o IdentitiesOnly=yes -o StrictHostKeyChecking=accept-new"

mkdir -p "$STATE" "$DIR/data"
exec 9>"$STATE/lock"
flock -n 9 || { echo "kpmr: a deploy is already running"; exit 0; }

log() { echo "kpmr: $*"; }
want=${1:-main}

if [[ ! -d $DIR/src/.git ]]; then git clone -q --bare "$REPO" "$DIR/src/.git"; fi
git --git-dir="$DIR/src/.git" fetch -q --prune origin "+refs/heads/*:refs/heads/*"
commit=$(git --git-dir="$DIR/src/.git" rev-parse --verify "$want^{commit}")
tag="git-${commit:0:12}"
deployed=$(cat "$STATE/deployed" 2>/dev/null || true)
if [[ $commit == "$deployed" && ${FORCE:-0} != 1 ]]; then log "$tag is live"; exit 0; fi

build=$(mktemp -d)
trap 'rm -rf "$build"' EXIT
git --git-dir="$DIR/src/.git" archive "$commit" | tar -x -C "$build"
log "building $tag"
if ! nice -n 10 docker build -q -t "kpmr:$tag" --build-arg "KPMR_REVISION=${commit:0:12}" "$build" >/dev/null; then
  echo "$commit" > "$STATE/failed"
  log "build of $tag failed; $deployed stays live"
  exit 1
fi

install -m 0644 "$build/deploy/compose.yaml" "$DIR/compose.yaml"
install -d "$DIR/bin" && install -m 0755 "$build/deploy/soap/kpmr-deploy" "$build/deploy/soap/kpmr-watch" "$DIR/bin/"
for unit in kpmr-watch.service kpmr-watch.timer; do
  if ! cmp -s "$build/deploy/soap/$unit" "/etc/systemd/system/$unit"; then install -m 0644 "$build/deploy/soap/$unit" /etc/systemd/system/; reload=1; fi
done
[[ ${reload:-0} == 1 ]] && systemctl daemon-reload && systemctl enable --now kpmr-watch.timer >/dev/null 2>&1

chown 1000:1000 "$DIR/data"
previous=$(sed -n 's/^KPMR_TAG=//p' "$DIR/.env" 2>/dev/null || true)
switch() { echo "KPMR_TAG=$1" > "$DIR/.env"; docker compose --project-directory "$DIR" up -d --force-recreate --wait --wait-timeout 120 kpmr; }

healthy() {

  for _ in $(seq 1 60); do
    if curl -fsS --max-time 5 --resolve "$HOST:443:127.0.0.1" "https://$HOST/healthz" 2>/dev/null | grep -q '"ready":true' \
      && curl -fsS --max-time 10 --resolve "$HOST:443:127.0.0.1" -o /dev/null "https://$HOST/v1/catalogue?providers=anthropic" \
      && curl -fsS --max-time 10 --resolve "$HOST:443:127.0.0.1" "https://$HOST/providers/anthropic" | grep -q '<div id="root">'; then
      return 0
    fi
    sleep 2
  done
  return 1
}

if switch "$tag" && healthy; then
  echo "$commit" > "$STATE/deployed"
  [[ -n $previous && $previous != "$tag" ]] && echo "$previous" > "$STATE/previous"
  rm -f "$STATE/failed"
  echo "$(date -u +%FT%TZ) $tag ok" >> "$STATE/history"
  log "$tag is live"
  keep="kpmr:$tag kpmr:${previous:-none}"
  docker images --format '{{.Repository}}:{{.Tag}}' kpmr | while read -r image; do
    [[ " $keep " == *" $image "* ]] || docker rmi -f "$image" >/dev/null 2>&1 || true
  done
else
  echo "$commit" > "$STATE/failed"
  echo "$(date -u +%FT%TZ) $tag failed" >> "$STATE/history"
  if [[ -n $previous ]]; then
    log "$tag is not healthy; rolling back to $previous"
    switch "$previous" || log "rollback to $previous failed too"
  fi
  exit 1
fi
